{
  "schema": 1,
  "components": [
    {
      "id": "javi_carlauncher",
      "kind": "app",
      "path": "apps/javi_carlauncher",
      "build": "unit",
      "mguHmi": [
        "ID8"
      ],
      "requires": {
        "javi-carlab": "0.2.22",
        "javi-ccu-gate": "1.1.0",
        "javi-aa-format": "1.0.0"
      }
    },
    {
      "id": "javi-carlab",
      "kind": "tool",
      "path": "native/javi-carlab"
    },
    {
      "id": "javi-ccu-gate",
      "kind": "tool",
      "path": "native/javi-ccu-gate",
      "version": "1.1.0",
      "title": "Captura del mando de BMWLauncher",
      "description": "Entrega el mando a BMWLauncher y permite giro y pulsación en Android Auto cuando tiene el foco.",
      "mguHmi": [
        "ID8"
      ],
      "optional": true,
      "uninstallable": true,
      "requires": {
        "javi-carlab": "0.2.4"
      },
      "preload": {
        "library": "javi-ccu-gate.so",
        "unit": "hmi8.service",
        "process": "Hmi8",
        "strikes": 2,
        "checkAfterSeconds": 120,
        "healthySeconds": 60
      }
    },
    {
      "id": "javi-aa-format",
      "kind": "tool",
      "path": "native/javi-aa-format",
      "version": "1.0.0",
      "title": "Formato de Android Auto para BMWLauncher",
      "description": "Adapta Android Auto al panel izquierdo. Se activa al reiniciar iDrive después de instalarlo.",
      "mguHmi": ["ID8"],
      "optional": true,
      "uninstallable": true,
      "requires": { "mgu-deploy": "0.7.0" },
      "preload": {
        "library": "javi-aa-format.so",
        "unit": "aapd.service",
        "process": "aapd",
        "strikes": 2,
        "checkAfterSeconds": 120,
        "healthySeconds": 60
      }
    }
  ]
}
