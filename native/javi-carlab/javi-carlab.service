[Unit]
Description=CarLauncher Lab iDrive 8 split-panel experiment
After=vsomeipd.service mgu-render.socket

[Service]
RuntimeDirectory=javi-carlab
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
ExecStart=/usr/bin/node /var/opt/javi-carlab/current/service.js
ExecStopPost=/usr/bin/node /var/opt/javi-carlab/current/aa.js --restore
Restart=on-failure
RestartSec=5s
LimitCORE=0
StandardOutput=journal

[Install]
WantedBy=multi-user.target
