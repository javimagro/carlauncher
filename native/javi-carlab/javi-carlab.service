[Unit]
Description=BMWLauncher iDrive 8
After=vsomeipd.service mgu-render.socket

[Service]
RuntimeDirectory=javi-carlab
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=restart
ExecStart=/usr/bin/node /var/opt/javi-carlab/current/service.js
Restart=on-failure
RestartSec=5s
LimitCORE=0
StandardOutput=journal

[Install]
WantedBy=multi-user.target
