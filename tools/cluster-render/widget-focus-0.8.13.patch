+bool Dcsm27Port::request_widget_focus(uint64_t owner, uint64_t content, int64_t now_ms, std::string *why)
+{
+    if (focus_owner_) {
+        *why = "focus request already active";
+        return false;
+    }
+    const Content *c = offered(content);
+    if (!up_ || content != kBmwLauncherWidget || !c || c->spec.name != "widget" || c->phase != Phase::Offered) {
+        *why = "BMWLauncher widget is not parked";
+        return false;
+    }
+    if (!wire_->focus_widget(content, true, why))
+        return false;
+    focus_owner_ = owner;
+    focus_content_ = content;
+    focus_until_ = now_ms + kWidgetFocusMs;
+    log_info("dcsm: content %llu: temporary widget focus requested", u(content));
+    return true;
+}
+
+void Dcsm27Port::end_widget_focus()
+{
+    std::string why;
+    if (wire_->focus_widget(focus_content_, false, &why))
+        log_info("dcsm: content %llu: temporary widget focus released", u(focus_content_));
+    else
+        log_error("dcsm: content %llu: widget focus release refused: %s", u(focus_content_), why.c_str());
+    focus_owner_ = 0;
+}
+
+void Dcsm27Port::cancel_widget_focus(uint64_t owner)
+{
+    if (focus_owner_ && focus_owner_ == owner)
+        end_widget_focus();
+}
+
+void Dcsm27Port::on_widget_focused(uint64_t content, int64_t now_ms)
+{
+    // Release outside RAMSES event dispatch, once the cluster confirms focus.
+    if (focus_owner_ && focus_content_ == content)
+        focus_until_ = now_ms;
+}
